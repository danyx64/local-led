{
  "name": "Local LED IWA",
  "short_name": "Local LED",
  "description": "Controllo locale di lampade ZENGGE/Magic Home via TCP Direct Sockets.",
  "version": "0.1.2",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#090a0d",
  "theme_color": "#090a0d",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "permissions_policy": {
    "direct-sockets": ["self"],
    "local-network": ["self"],
    "loopback-network": ["self"],
    "cross-origin-isolated": ["self"]
  }
}
